    {
      "id": "ch02_rain_foundry_canal_daily",
      "region_id": "demo_ch02_rain_foundry_canal",
      "role": "daily",
      "room_id": "aqueduct_shrine",
      "floor_id": "shrine_floor_a",
      "position": [
        3085,
        1208
      ],
      "look": "pump_manifold",
      "title": "泵渠分流箱",
      "text": "三路铜管先分往住处，再接进炉膛，阀边同时刻着水位和轮班记号。如今水仍沿旧路走，工人的名字却只留在工牌背面。\n\n绊线钉把旧泵闸的绷线卡榫改成便携机关；雨铸匠修复铜徽章与承力线结，才重新接通司铸契印的手艺。",
      "room_title": "渡槽钟龛"
    },
    {
      "id": "ch02_rain_foundry_canal_witness",
      "region_id": "demo_ch02_rain_foundry_canal",
