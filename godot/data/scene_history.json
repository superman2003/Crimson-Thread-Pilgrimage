      "room_title": "封存书堆"
    },
    {
      "id": "ch04_broken_string_greenhouse_daily",
      "region_id": "demo_ch04_broken_string_greenhouse",
      "role": "daily",
      "room_id": "tree_heart",
      "floor_id": "heart_floor",
      "position": [
        2845,
        1570
      ],
      "look": "graft_bench",
      "title": "接弦养根槽",
      "text": "细弦把水槽连向幼根，旧铜箍护着已经缝合的切口。园圃原以移栽与接弦延续母株，后来新增的外箍却把养根的线路接进了钟网。\n\n园工用小铃互报剪枝节拍；雨铸匠铸的铃配上温室的传声弦，成为能把猎物引离原位的回响诱铃。",
      "room_title": "大树之心"
    },
