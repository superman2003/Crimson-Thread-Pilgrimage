    {
      "id": "ch05_obsidian_pilgrim_road_daily",
      "region_id": "demo_ch05_obsidian_pilgrim_road",
      "role": "daily",
      "room_id": "pilgrim_camp",
      "floor_id": "camp_floor",
      "position": [
        285,
        1878
      ],
      "look": "name_spool",
      "title": "营床点名轮",
      "text": "点名轮上装着可拆的木条，槽号与营床对应。旧刻痕把收起的木条归入亡者一侧，后来的钉孔却把它们重新钉回轮中。\n\n悼念与征召挤在同一件设施上。军墓旗手背带的承力扣仍留在旁边，提醒巡礼者装备原先也是人们生活和劳作的工具。",
      "room_title": "巡礼营地"
    },
    {
