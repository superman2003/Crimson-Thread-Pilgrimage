      "room_title": "沉没档案舱"
    },
    {
      "id": "ch03_saltwhite_archive_daily",
      "region_id": "demo_ch03_saltwhite_archive",
      "role": "daily",
      "room_id": "crest_bridge",
      "floor_id": "crest_deck",
      "position": [
        4795,
        848
      ],
      "look": "book_press",
      "title": "运书压页台",
      "text": "书托沿窄轨进入双辊，纸屑和盐粉落在同一条槽里。原本用于压平受潮书页的刮刀，也被用来刮去契约上的字。\n\n盐雾瓶沿用书库收存盐粉的封蜡小瓶；书库的细针蘸上盐墨，才成为测路者补绘旅途的盐墨绘针。校录契印来自核对删名记录后复原的印记。",
      "room_title": "天顶盐桥"
    },
    {
      "id": "ch03_saltwhite_archive_witness",
