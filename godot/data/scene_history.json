    {
      "id": "ch06_silent_crown_core_daily",
      "region_id": "demo_ch06_silent_crown_core",
      "role": "daily",
      "room_id": "bell_tongue_vault",
      "floor_id": "vault_floor",
      "position": [
        2665,
        2868
      ],
      "look": "lock_comb",
      "title": "钟舌分钥架",
      "text": "开门、停钟和放水的钥匙原本各排一列，末端却被加装的铜轨接回同一把总锁。设施原有的分工仍能辨认，决定权后来才被合拢。\n\n这里让人看见守潮与锁住人声之间的缝隙；它没有替巡礼者取得证词，也没有替任何人作出终局选择。",
      "room_title": "钟舌库"
    },
