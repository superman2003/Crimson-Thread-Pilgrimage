  "main_story": {
    "title": "失声契约",
    "protagonist_goal": "把六位守门者的原始证词带回王冠，辨清自愿守潮如何变成世代失声，再选择承担何种后果。",
    "causal_chain": [
      "六城曾请求六位守门者以心镇守黑潮，契约原本仅约束自愿签署者。",
      "王冠将契约的自愿改为世袭，书库删去反对者姓名，雨铸工牌与巡礼军令延续这一篡改。",
      "守门者既是执行者也是被抵押的人：记忆残存，行动仍被钟令驱动。",
      "主角由初代巡礼者的线结唤醒，但不会替众人作无代价的选择。六份独立证词可以按任何顺序发现。"
    ],
    "critical_path": [
      "探索六区与能力路线",
      "击败无声王冠",
      "选择重鸣或断冠；集齐六区证词后可改写契约"
    ],
    "optional_quests_required": false,
    "response_boundary": "主角少言，以点头、收线与将证物放在对方面前回应；关键回应跟随主动交谈，不打断普通探索。"
  },
