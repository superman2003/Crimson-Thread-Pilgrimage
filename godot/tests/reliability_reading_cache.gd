extends SceneTree
const JOURNAL = preload("res://scripts/journal_reading.gd")
const DIALOGUE = preload("res://scripts/dialogue_reading_memory.gd")
var checks := 0
var failures: Array[String] = []
func check(ok: bool, label: String) -> void:
    checks += 1
    if not ok:failures.append(label)
func _initialize() -> void:
    var j := JOURNAL.new()
    var text := "长篇已知旅记。".repeat(10000)
    j.capture("long", text, 128.5)
    check(j.resume("long", text) == 128.5, "long Chinese text restores fractional offset")
    check(JSON.stringify(j.bookmarks).length() < 256 and not JSON.stringify(j.bookmarks).contains("长篇"), "cache memory does not scale with document length")
    check(j.resume("long", text + "变") == 0.0 and not j.bookmarks.has("long"), "changed content retires obsolete bookmark")
    for i in 64:j.capture(str(i), "text", i + 1.0)
    check(j.resume("0", "text") == 1.0, "opening oldest entry refreshes recency")
    j.capture("new", "text", 77)
    check(j.resume("0", "text") == 1.0 and not j.bookmarks.has("1"), "reading protects active bookmark when full")
    j.capture("bad", "text", NAN);j.capture("bad", "text", INF)
    check(not j.bookmarks.has("bad"), "invalid scroll never enters cache")
    j.capture("negative", "text", -4);j.capture("large", "text", 1e20)
    check(j.resume("negative", "text") == 0 and j.resume("large", "text") == JOURNAL.MAX_SCROLL, "scroll is bounded at both ends")
    j.capture("large", "", 1)
    check(not j.bookmarks.has("large"), "empty content clears prior offset")
    j.capture("x".repeat(1025), "text", 5)
    check(not j.bookmarks.has("x".repeat(1025)), "keys cannot evade memory bound")
    j.forget("negative");check(not j.bookmarks.has("negative"), "single bookmark can be removed")
    j.clear();check(j.bookmarks.is_empty(), "session cache supports explicit reset")
    var d := DIALOGUE.new()
    d.capture("line", 20, 8, 50, false)
    var copy := d.restore("line");copy.characters = 999
    check(d.restore("line").characters == 8 and is_equal_approx(d.restore("line").progress, 0.4), "returned state is detached and preserves reveal proportion")
    for i in 64:d.capture(str(i), 10, i, i, false)
    d.restore("0");d.capture("next", 10, -1, 2000000, false)
    check(not d.restore("0").is_empty() and d.restore("1").is_empty(), "dialogue cache also refreshes on reading")
    check(d.restore("next").characters == 10 and d.restore("next").scroll == DIALOGUE.MAX_SCROLL, "full reveal and scroll stay bounded")
    d.capture("next", 10, 0, 0, true)
    check(d.restore("next").is_empty(), "committed dialogue cannot resume")
    d.capture("zero", 0, 8, -8, false)
    check(d.restore("zero").is_empty(), "empty dialogue cannot divide by zero")
    d.capture("x".repeat(1025), 10, 1, 0, false)
    check(not d._entries.has("x".repeat(1025)), "dialogue key storage is bounded")
    d.clear();check(d._entries.is_empty(), "dialogue reset drops session-only offsets")
    for failure in failures:push_error(failure)
    print("RELIABILITY_READING_CACHE checks=%d failures=%d" % [checks, failures.size()])
    quit(0 if failures.is_empty() else 1)
