extends SceneTree
const POLICY = preload("res://scripts/combat_visual_policy.gd")
var checks := 0
var failures: Array[String] = []
func check(ok: bool, label: String) -> void:
    checks += 1
    if not ok:failures.append(label)
func _initialize() -> void:call_deferred("run")
func run() -> void:
    var host := Node2D.new();root.add_child(host)
    var existing := Node2D.new();host.add_child(existing)
    check(not POLICY.attach_contact(host, existing) and is_instance_valid(existing) and existing.get_parent() == host, "contact rejection preserves borrowed actor")
    check(not POLICY.attach_action_trace(host, existing) and is_instance_valid(existing), "trace rejection preserves borrowed actor")
    check(not POLICY.attach_contact(host, null) and not POLICY.attach_action_trace(host, null), "null inputs do not crash")
    var detached_host := Node.new()
    var rejected := Node2D.new()
    check(not POLICY.attach_contact(detached_host, rejected) and not is_instance_valid(rejected), "fresh rejected item is reclaimed")
    detached_host.free()
    check(not POLICY.attach_secondary_batch(host, [], &"motion"), "empty batch is not a successful admission")
    var one := Node2D.new()
    check(not POLICY.attach_secondary_batch(host, [one, one], &"motion") and not is_instance_valid(one), "duplicate batch root is rejected and freed once")
    var fresh := Node2D.new()
    check(not POLICY.attach_secondary_batch(host, [fresh, existing], &"motion") and not is_instance_valid(fresh) and is_instance_valid(existing), "mixed invalid batch reclaims fresh node but preserves borrowed node")
    var owner := Node.new()
    var item := Node2D.new()
    check(not POLICY.attach_secondary(host, item, &"motion", owner) and not is_instance_valid(item), "detached owner cannot acquire world effects")
    owner.free()
    var composite := Node2D.new()
    for i in 4:composite.add_child(Node2D.new())
    check(POLICY.attach_secondary(host, composite, &"motion", host), "fresh composite is admitted atomically")
    check(composite.get_meta("secondary_units") == 5 and composite.z_index <= POLICY.SECONDARY_MAX_Z, "child visuals count toward budget and layer cap")
    var overflow := Node2D.new()
    for i in 12:overflow.add_child(Node2D.new())
    check(not POLICY.attach_secondary(host, overflow, &"motion") and not is_instance_valid(overflow), "oversized composite cannot partially consume budget")
    POLICY.clear_secondary(host)
    var replacement := Node2D.new()
    check(POLICY.attach_secondary(host, replacement, &"motion", host), "retired decorations release budget immediately")
    for i in POLICY.MAX_CONTACTS:check(POLICY.attach_contact(host, Node2D.new()), "contacts fill bounded pool")
    var extra := Node2D.new()
    check(not POLICY.attach_contact(host, extra) and not is_instance_valid(extra), "contact pool cap frees overflow")
    var danger := Node2D.new()
    check(POLICY.attach_action_trace(host, danger, true) and danger.z_index == POLICY.WARNING_Z, "warning admission remains independent of cosmetic pool")
    POLICY.place_danger(null)
    check(is_instance_valid(existing), "invalid danger-layer request preserves scene")
    host.queue_free();await process_frame
    for failure in failures:push_error(failure)
    print("RELIABILITY_VISUAL_OWNERSHIP checks=%d failures=%d" % [checks, failures.size()])
    quit(0 if failures.is_empty() else 1)
